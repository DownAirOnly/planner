rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/backups/{backupId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == uid && backupId == "current";
    }
    match /users/{uid}/finance/{docId} {
      allow read, create, update: if request.auth != null &&
        request.auth.uid == uid && docId == "manifest";
    }
    match /users/{uid}/financeChunks/{chunkId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(["revision", "index", "text"]) &&
        request.resource.data.revision is string &&
        request.resource.data.index is int &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 120000;
      // Committed snapshot chunks cannot be mutated or deleted.
      allow update, delete: if false;
    }
  }
}
